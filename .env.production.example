# Production environment contract. Copy to your hosting platform's secret store (never commit real values).
# Validate with:  node --env-file=.env.production scripts/production-check.mjs   (after pnpm build:api)

# --- API -------------------------------------------------------------------
NODE_ENV=production
HOST=0.0.0.0
PORT=4000
CORS_ORIGINS=https://admin.example.it
TRUST_PROXY=1
APP_VERSION=1.0.0
# 48+ random characters: openssl rand -base64 48
AUTH_ACCESS_TOKEN_SECRET=
DATABASE_URL=postgresql://USER:PASSWORD@db.example.it:5432/flower_man
DATABASE_SSL=true

# --- Email -------------------------------------------------------------------
MAIL_TRANSPORT=smtp
SMTP_URL=smtps://USER:PASSWORD@smtp.example.it:465
MAIL_FROM=Flower Man <no-reply@example.it>
EMAIL_LINK_BASE_URL=https://app.example.it

# --- Payments (Stripe live) ---------------------------------------------------
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PLATFORM_COMMISSION_BPS=1500

# --- Push / storage ---------------------------------------------------------------
PUSH_ENABLED=true
EXPO_ACCESS_TOKEN=
# Object storage for delivery proof photos (S3-compatible driver: see ADR-012).
STORAGE_DRIVER=

# --- Platform Owner bootstrap (run once per environment) -------------------------
PLATFORM_OWNER_EMAIL=
PLATFORM_OWNER_PASSWORD=
PLATFORM_OWNER_NAME=

# --- Admin web (server-side) -------------------------------------------------------
ADMIN_API_URL=https://api.example.it

# --- Mobile builds (EAS secrets / build profile env) -------------------------------
EXPO_PUBLIC_API_URL=https://api.example.it
# From `npx eas-cli init` in each app folder (two different projects). Never invent these.
CUSTOMER_EAS_PROJECT_ID=
PARTNER_EAS_PROJECT_ID=
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://example.it/privacy
EXPO_PUBLIC_TERMS_OF_SERVICE_URL=https://example.it/terms

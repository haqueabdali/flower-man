# Local development environment.
# Copy once:  cp .env.example .env
# .env is gitignored. Never commit real credentials.

# --- API (pnpm dev:api) ------------------------------------------------------
NODE_ENV=development
# 127.0.0.1 = only this PC. Use 0.0.0.0 to test from a phone on the same Wi-Fi.
HOST=127.0.0.1
PORT=4000
# Browser origins allowed by CORS, comma-separated (the admin web app). Mobile apps do not need CORS.
CORS_ORIGINS=http://localhost:3000
# Number of reverse proxies in front of the API (false locally).
TRUST_PROXY=false
# Signs access tokens. Dev-only value; production refuses it (generate: openssl rand -base64 48).
AUTH_ACCESS_TOKEN_SECRET=dev-only-access-token-secret-change-me-0000

# --- PostgreSQL/PostGIS from infra/compose.yaml (pnpm db:up) ----------------
# Percent-encode special characters (@ : / ? # %) in the user name and password.
DATABASE_URL=postgresql://flower_man:flower_man@127.0.0.1:55432/flower_man
# Local Docker database has no TLS. Production must use DATABASE_SSL=true.
DATABASE_SSL=false

# --- Email (verification and password reset links) --------------------------
# smtp + Mailpit from infra/compose.yaml (inbox: http://localhost:8025). "log" prints emails to the API log instead.
MAIL_TRANSPORT=smtp
SMTP_URL=smtp://127.0.0.1:1025
MAIL_FROM=Flower Man <no-reply@flowerman.localhost>
# Links in emails point here (the app/web page that handles /verify-email and /reset-password).
EMAIL_LINK_BASE_URL=http://localhost:3000

# --- Marketplace ---------------------------------------------------------------
# Platform commission on the order subtotal in basis points (1500 = 15%).
PLATFORM_COMMISSION_BPS=1500
UNPAID_ORDER_TTL_MINUTES=30
CUSTOM_REQUEST_TTL_HOURS=48

# --- Payments -----------------------------------------------------------------
# simulated (development only) or stripe. With stripe, payment success comes ONLY from the signed webhook.
PAYMENT_PROVIDER=simulated
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Push notifications (Expo) ---------------------------------------------------
PUSH_ENABLED=false
EXPO_ACCESS_TOKEN=

# --- File storage (delivery proof photos) ---------------------------------------
# local (development) or s3 (any S3-compatible bucket; required in production, see .env.production.example).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=storage

# --- Rate limits ------------------------------------------------------------------
# memory (one API process) or postgres (shared by every API instance; default in production).
RATE_LIMIT_STORE=memory

# --- Alerts (optional) -------------------------------------------------------------
# Team chat webhook for 500 errors and failed background jobs (Slack/Google Chat; Discord: append /slack).
ALERT_WEBHOOK_URL=

# --- Platform Owner bootstrap (pnpm bootstrap:platform-owner) --------------------
PLATFORM_OWNER_EMAIL=owner@flowerman.localhost
PLATFORM_OWNER_PASSWORD=change-this-local-owner-password
PLATFORM_OWNER_NAME=Platform Owner

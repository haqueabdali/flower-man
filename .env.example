# Local development environment.
# Copy once:  cp .env.example .env
# .env is gitignored. Never commit real credentials.

# --- API (pnpm dev:api) ------------------------------------------------------
NODE_ENV=development
# 127.0.0.1 = only this PC. Use 0.0.0.0 to test from a phone on the same Wi-Fi.
HOST=127.0.0.1
PORT=4000
# Browser origins allowed by CORS, comma-separated (the admin web app). Mobile apps do not need CORS.
CORS_ORIGINS=http://localhost:3000
# Number of reverse proxies in front of the API (false locally).
TRUST_PROXY=false
# Signs access tokens. Dev-only value; production refuses it (generate: openssl rand -base64 48).
AUTH_ACCESS_TOKEN_SECRET=dev-only-access-token-secret-change-me-0000

# --- PostgreSQL/PostGIS from infra/compose.yaml (pnpm db:up) ----------------
# Percent-encode special characters (@ : / ? # %) in the user name and password.
DATABASE_URL=postgresql://flower_man:flower_man@127.0.0.1:55432/flower_man
# Local Docker database has no TLS. Production must use DATABASE_SSL=true.
DATABASE_SSL=false

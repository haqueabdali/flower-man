{
  "name": "@flower-man/customer-mobile",
  "version": "0.0.0",
  "private": true,
  "description": "Flower Man customer app (Expo).",
  "scripts": {
    "start": "expo start --dev-client",
    "start:go": "expo start",
    "android": "expo start --android",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "export:check": "expo export --platform android --output-dir dist-export",
    "eas-build-post-install": "pnpm --dir ../.. run build:core"
  },
  "dependencies": {
    "@flower-man/api-client": "workspace:*",
    "@flower-man/contracts": "workspace:*",
    "@stripe/stripe-react-native": "0.64.0",
    "expo": "~57.0.30",
    "expo-constants": "~57.0.22",
    "expo-device": "~57.0.2",
    "expo-linking": "~57.0.13",
    "expo-location": "~57.0.21",
    "expo-notifications": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.18",
    "typescript": "catalog:"
  },
  "main": "index.ts"
}

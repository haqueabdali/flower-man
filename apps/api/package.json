{
  "name": "@flower-man/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Flower Man REST API (NestJS) and database migration CLI.",
  "scripts": {
    "build": "node ../../scripts/clean.mjs dist && tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "dev": "pnpm run build && node scripts/dev.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ../../scripts/clean.mjs dist-test && tsc -p tsconfig.test.json && node --test \"dist-test/**/*.test.js\"",
    "test:integration": "node ../../scripts/clean.mjs dist-test && tsc -p tsconfig.test.json && node --env-file-if-exists=../../.env --test --test-concurrency=1 --test-timeout=120000 \"dist-test/**/*.integration.js\"",
    "db:migrate": "pnpm run build && node --env-file-if-exists=../../.env dist/database/migrate.js up --dir ../../infra/database/migrations",
    "db:migrate:status": "pnpm run build && node --env-file-if-exists=../../.env dist/database/migrate.js status --dir ../../infra/database/migrations",
    "bootstrap:platform-owner": "pnpm run build && node --env-file-if-exists=../../.env dist/cli/bootstrap-platform-owner.js",
    "db:seed:demo": "pnpm run build && node --env-file-if-exists=../../.env dist/cli/seed-demo.js"
  },
  "dependencies": {
    "@flower-man/contracts": "workspace:*",
    "@flower-man/domain": "workspace:*",
    "@flower-man/security": "workspace:*",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "nodemailer": "^10.1.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "stripe": "^23.0.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "typescript": "catalog:"
  }
}

google-services.json
GoogleService-Info.plist

# Local uploads (development storage for delivery proof etc.). Anchored so src/storage/ code is not ignored.
/storage/
/apps/*/storage/

# Logs and OS/editor files
*.log
npm-debug.log*
pnpm-debug.log*
.DS_Store
Thumbs.db
.idea/
